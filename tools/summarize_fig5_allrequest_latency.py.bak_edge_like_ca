write_matrix("ACT_all", "Fig.5 All-request: ACT_all", "fig5_allrequest_act_all_matrix.md")
write_matrix("P95_all", "Fig.5 All-request: P95_all", "fig5_allrequest_p95_all_matrix.md")
write_matrix("CMS_all", "Fig.5 All-request: CMS_all", "fig5_allrequest_cms_all_matrix.md")
